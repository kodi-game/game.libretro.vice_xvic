msgctxt "#30106"
msgid ""
"'Automatic' switches region per file path tags.\n"
"Changing while running resets the system!"
msgstr ""
"'Automatico' cambia regione in base ai tag del percorso file.\n"
"La modifica durante l'esecuzione reimposta il sistema!"

